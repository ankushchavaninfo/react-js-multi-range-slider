{
  "name": "react-js-multi-range-sliders",
  "version": "0.3.0",
  "author": "Ankush Chavan",
  "license": "MIT",
  "description": "React Smart Range Selectors — single, dual-thumb, vertical, multi-point, and circular sliders with 4 themes, tooltips, TypeScript, and zero runtime dependencies.",
  "homepage": "https://github.com/ankushchavaninfo/react-js-multi-range-slider#readme",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types":   "./lib/index.d.ts",
      "import":  "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./RangeSlider": {
      "types":   "./lib/RangeSlider.d.ts",
      "import":  "./lib/RangeSlider.mjs",
      "require": "./lib/RangeSlider.js"
    },
    "./SingleSlider": {
      "types":   "./lib/SingleSlider.d.ts",
      "import":  "./lib/SingleSlider.mjs",
      "require": "./lib/SingleSlider.js"
    },
    "./VerticalSlider": {
      "types":   "./lib/VerticalSlider.d.ts",
      "import":  "./lib/VerticalSlider.mjs",
      "require": "./lib/VerticalSlider.js"
    },
    "./MultiPointSlider": {
      "types":   "./lib/MultiPointSlider.d.ts",
      "import":  "./lib/MultiPointSlider.mjs",
      "require": "./lib/MultiPointSlider.js"
    },
    "./CircularSlider": {
      "types":   "./lib/CircularSlider.d.ts",
      "import":  "./lib/CircularSlider.mjs",
      "require": "./lib/CircularSlider.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankushchavaninfo/react-js-multi-range-slider.git"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "pack:check": "npm pack --dry-run",
    "publish:public": "npm publish --access public",
    "version": "npm run build && git add lib",
    "release:patch": "npm version patch && git push origin main --follow-tags",
    "release:minor": "npm version minor && git push origin main --follow-tags",
    "release:major": "npm version major && git push origin main --follow-tags",
    "release:beta": "npm version prerelease --preid=beta && git push origin main --follow-tags"
  },
  "bugs": {
    "url": "https://github.com/ankushchavaninfo/react-js-multi-range-slider/issues"
  },
  "keywords": [
    "react",
    "react-component",
    "react-range-slider",
    "react-slider",
    "range-input",
    "dual-thumb",
    "double-range-slider",
    "multi-range-slider",
    "range-selector",
    "vertical-slider",
    "circular-slider",
    "multi-point-slider",
    "rtl",
    "accessible",
    "aria",
    "typescript",
    "tree-shakeable",
    "slider",
    "ui"
  ],
  "files": [
    "lib",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "react": "^16.0.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.0.0 || ^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "babel-loader": "^8.4.0",
    "css-loader": "^6.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "style-loader": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
